{
  "manifest_version": 3,
  "name": "AI Flywheel Extension",
  "description": "Sort Instagram profiles, Reels, and Explore by real engagement. See the views, likes, and comments the app hides.",
  "version": "1.2.9",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://aiflywheel-extension.vercel.app/*"],
  "permissions": ["storage", "downloads"],
  "web_accessible_resources": [
    {
      "resources": ["fonts/Geist-Variable.woff2"],
      "matches": ["*://*.tiktok.com/*", "*://*.instagram.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://*.tiktok.com/*", "*://*.instagram.com/*"],
      "js": ["src/schema/instagram.js", "src/page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.tiktok.com/*", "*://*.instagram.com/*"],
      "js": ["src/profile-cache.js", "src/post-cache.js", "src/download-export.js", "src/story-highlight.js", "src/ui/styles.js", "src/control-offset.js", "src/content.js"],
      "run_at": "document_start"
    }
  ]
}
